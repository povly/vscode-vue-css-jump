{
  "name": "vscode-vue-css-jump",
  "displayName": "Vue CSS Jump",
  "description": "Ctrl+Click navigation for Vue SFC styles: $style class definitions, style src files, smart tab reuse",
  "version": "0.1.0",
  "publisher": "povly",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/povly/vscode-vue-css-jump"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "vue",
    "css modules",
    "style",
    "navigation",
    "go to definition"
  ],
  "activationEvents": [
    "onLanguage:vue"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test": "vitest run",
    "package": "npm run build && python3 scripts/build-vsix.py"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
